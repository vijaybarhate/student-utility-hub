---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  {
    id: 'calculators',
    label: 'Calculators',
    blurb: 'Instant academic math — attendance, grades and pass criteria.',
    tools: [
      {
        title: 'Attendance & Bunk Tracker',
        description: 'Calculate if you can skip today\'s lectures or find exactly how many classes you must attend to maintain 75% attendance.',
        href: '/attendance-calculator',
        badge: 'Popular',
        icon: 'calendar',
        tags: ['attendance', 'bunk', 'skip class', '75 percent', 'college tracker']
      },
      {
        title: 'GPA (SGPA/CGPA) Calculator',
        description: 'Calculate semester SGPA and overall CGPA using credit-weighted grades. Supports custom target grading simulator.',
        href: '/gpa-calculator',
        badge: 'Core',
        icon: 'graduation-cap',
        tags: ['gpa', 'sgpa', 'cgpa', 'grades', 'credits', 'marks']
      },
      {
        title: 'Target CGPA Planner',
        description: 'Calculate the SGPA you need in remaining semesters to reach your target CGPA. Plan semester-by-semester scores with credit weighting.',
        href: '/target-cgpa-planner',
        badge: 'New',
        icon: 'trending-up',
        tags: ['target cgpa', 'sgpa needed', 'future grades', 'credit planning', 'gpa goal']
      },
      {
        title: 'CGPA to Percentage Converter',
        description: 'Convert 10-point CGPA to marks percentage instantly using official university formulas for SPPU, VTU, MU, and others.',
        href: '/cgpa-to-percentage',
        badge: 'Updated',
        icon: 'percent',
        tags: ['percentage', 'cgpa to percent', 'sppu', 'vtu', 'mumbai university', 'convert']
      },
      {
        title: 'Marks Needed to Pass',
        description: 'Find out exactly how much you need to score in semester-end theory exams to pass or reach your target grade.',
        href: '/marks-needed-to-pass',
        badge: 'New',
        icon: 'target',
        tags: ['pass marks', 'passing criteria', 'internals', 'theory marks', 'exam prep']
      },
      {
        title: 'ATKT & Backlog Helper',
        description: 'Check your eligibility to keep terms (ATKT) and learn the backlog promotion rules for major Indian universities.',
        href: '/atkt-eligibility-helper',
        badge: 'Guide',
        icon: 'shield-alert',
        tags: ['atkt', 'backlog', 'fail subject', 'promotion rules', 'year down', 'kt rules']
      }
    ]
  },
  {
    id: 'trackers',
    label: 'Trackers',
    blurb: 'Keep a live eye on deadlines, marks and momentum.',
    tools: [
      {
        title: 'Exam Countdown & Deadline Tracker',
        description: 'Track every paper, internal, and submission deadline with a live countdown. Get urgency warnings when an exam is within 7 days.',
        href: '/exam-countdown',
        badge: 'New',
        icon: 'clock',
        tags: ['exam countdown', 'deadline', 'days left', 'exam date', 'study plan', 'tracker']
      },
      {
        title: 'Marks Ledger & Grade Tracker',
        description: 'Record internal and external marks per subject and see totals, percentages, and letter grades compute instantly. Spot failures and your best subject at a glance.',
        href: '/marks-ledger',
        badge: 'New',
        icon: 'clipboard',
        tags: ['marks ledger', 'grades', 'internal marks', 'external marks', 'percentage', 'letter grade', 'result tracker', 'score tracker']
      }
    ]
  },
  {
    id: 'planners',
    label: 'Planners',
    blurb: 'Structure your day and your whole term in one place.',
    tools: [
      {
        title: 'Pomodoro Study Timer',
        description: 'Focus with 25-minute Pomodoro sprints, short and long breaks, and a daily focus log that persists locally on your device.',
        href: '/study-timer',
        badge: 'New',
        icon: 'timer',
        tags: ['pomodoro', 'study timer', 'focus timer', '25 minutes', 'break timer', 'productivity', 'time management']
      },
      {
        title: 'Semester Syllabus Tracker',
        description: 'Break each subject into units and tick them off as you cover them. Watch your overall term progress climb — all saved locally on your device.',
        href: '/semester-tracker',
        badge: 'New',
        icon: 'book-open',
        tags: ['syllabus', 'semester tracker', 'units', 'checklist', 'subject progress', 'syllabus planner', 'exam prep']
      }
    ]
  }
];

const totalTools = categories.reduce((count, category) => count + category.tools.length, 0);

const faq = [
  {
    question: "What is Student Utility Hub?",
    answer: "Student Utility Hub is a premium, distraction-free suite of academic calculators designed specifically for Indian college students. It provides instant, local-first calculations for attendance, grades, pass marks, and university regulations."
  },
  {
    question: "Are my attendance and grade records saved?",
    answer: "Yes, but they are stored entirely inside your browser's local storage. We do not run databases or track your personal academic details. All data stays safe and private on your device."
  },
  {
    question: "Are the university conversion formulas official?",
    answer: "Yes, our calculators utilize the standard multiplier formulas specified in the official circulars of universities like SPPU (Pune), Mumbai University, VTU, and Anna University. However, always refer to your final official transcript for administrative submissions."
  }
];
---

<BaseLayout
  title="Student Utility Hub | CGPA, Attendance, Trackers & Study Tools"
  description="Free student tools for CGPA, attendance, ATKT eligibility, pass marks, exam countdowns, study timers, syllabus tracking and grade ledgers — all local-first."
  {faq}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-canvas py-16 md:py-24 transition-colors duration-200 border-b border-hairline">
    <!-- Atmospheric SVG Mesh Gradient -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden select-none opacity-40 dark:opacity-20" aria-hidden="true">
      <svg class="absolute -top-[30%] left-1/2 -translate-x-1/2 w-[120%] h-[160%] min-w-[1000px]" fill="none" viewBox="0 0 1200 1200">
        <g filter="url(#blur-filters)">
          <!-- Cyan-blue develop blob -->
          <circle cx="400" cy="300" r="300" fill="url(#develop-grad)" />
          <!-- Violet-pink preview blob -->
          <circle cx="800" cy="500" r="350" fill="url(#preview-grad)" />
          <!-- Coral-amber ship blob -->
          <circle cx="550" cy="800" r="280" fill="url(#ship-grad)" />
        </g>
        <defs>
          <filter id="blur-filters" x="-50%" y="-50%" width="200%" height="200%" filterUnits="objectBoundingBox">
            <feGaussianBlur stdDeviation="110" />
          </filter>
          <linearGradient id="develop-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#007cf0" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#00dfd8" stop-opacity="0.2" />
          </linearGradient>
          <linearGradient id="preview-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#7928ca" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#ff0080" stop-opacity="0.2" />
          </linearGradient>
          <linearGradient id="ship-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ff4d4d" stop-opacity="0.7" />
            <stop offset="100%" stop-color="#f9cb28" stop-opacity="0.1" />
          </linearGradient>
        </defs>
      </svg>
    </div>

    <!-- Content -->
    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-soft px-3 py-1 text-xs font-semibold font-mono text-body tracking-tight">
        <span class="flex h-2 w-2 rounded-full bg-success"></span>
        Distraction-Free Utilities
      </span>

      <!-- Sentence-case period-terminated display-xl Vercel headline -->
      <h1 class="mt-6 font-sans text-4xl font-semibold tracking-[-1.5px] leading-tight text-ink sm:text-5xl md:text-6xl md:tracking-[-2.4px]">
        Keep your term in check.
      </h1>
      
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-body md:text-xl">
        A fast, local-first suite of calculators, trackers, and planners for Indian college students. Track your attendance limits, convert semester grades, count down to papers, and plan your term.
      </p>

      <!-- Primary CTA Action -->
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#tools-grid" class="btn-primary">
          Explore All Tools
        </a>
        <a href="/about" class="btn-secondary">
          How it works
        </a>
      </div>

      <!-- Search Input -->
      <div class="mx-auto mt-12 max-w-md">
        <div class="relative flex items-center">
          <input
            type="text"
            id="tool-search"
            placeholder="Search tools (e.g., bunk, cgpa, pass marks)…"
            class="h-12 w-full rounded-md border border-hairline-strong bg-canvas pl-11 pr-4 text-sm text-ink placeholder-mute shadow-level-2 focus:ring-2 focus:ring-link/20 focus:outline-none transition-all duration-200"
            autocomplete="off"
            spellcheck="false"
          />
          <svg
            class="absolute left-3.5 h-5 w-5 text-mute"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Directory Grid -->
  <section id="tools-grid-section" class="py-20 md:py-32 bg-canvas-soft transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Section Title -->
      <div class="mb-12 flex items-end justify-between border-b border-hairline pb-8">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-mute font-mono">
            Directory
          </h2>
          <p class="mt-2 text-2xl font-bold tracking-tight text-ink md:text-3xl">
            Launch Academic Tools
          </p>
        </div>
        <span id="results-count" class="text-xs font-mono font-semibold text-mute hidden md:inline-block bg-canvas-soft-2 px-2 py-1 rounded-sm border border-hairline">
          Showing {totalTools} utilities
        </span>
      </div>

      <!-- No Results State -->
      <div id="no-results" class="hidden py-16 text-center border border-dashed border-hairline-strong rounded-md bg-canvas">
        <svg class="mx-auto h-8 w-8 text-mute" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p class="mt-4 text-sm font-semibold text-body">No matching tools found.</p>
        <button id="reset-search" class="mt-2 text-xs font-bold text-link hover:underline">
          Reset search filter
        </button>
      </div>

      <!-- Category Grids -->
      <div id="tools-grid">
        {categories.map(category => (
          <section
            data-category={category.id}
            class="mb-16 last:mb-0"
            aria-labelledby={`category-${category.id}`}
          >
            <div class="mb-8 flex items-end justify-between gap-4 border-b border-hairline pb-4">
              <h3
                id={`category-${category.id}`}
                class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-ink"
              >
                {category.label}
                <span class="ml-2 font-sans text-xs font-semibold uppercase tracking-normal text-mute">
                  {category.tools.length}
                </span>
              </h3>
              <p class="hidden text-sm text-body sm:block">
                {category.blurb}
              </p>
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {category.tools.map(tool => (
                <div
                  class="tool-card group relative flex flex-col justify-between overflow-hidden rounded-md border border-hairline-strong bg-canvas p-8 shadow-level-2 hover:shadow-level-4 transition-all duration-300 hover:-translate-y-1"
                  data-title={tool.title.toLowerCase()}
                  data-tags={tool.tags.join(' ')}
                  data-desc={tool.description.toLowerCase()}
                >
                  <div>
                    <div class="flex items-start justify-between">
                      <!-- Icon Frame -->
                      <div class="flex h-10 w-10 items-center justify-center rounded-md bg-canvas-soft-2 text-ink border border-hairline-strong transition-colors group-hover:bg-primary group-hover:text-on-primary">
                        {tool.icon === 'calendar' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                        )}
                        {tool.icon === 'graduation-cap' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5" /></svg>
                        )}
                        {tool.icon === 'percent' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="19" y1="5" x2="5" y2="19" /><circle cx="6.5" cy="6.5" r="2.5" /><circle cx="17.5" cy="17.5" r="2.5" /></svg>
                        )}
                        {tool.icon === 'target' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>
                        )}
                        {tool.icon === 'shield-alert' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                        )}
                        {tool.icon === 'trending-up' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
                        )}
                        {tool.icon === 'clock' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        )}
                        {tool.icon === 'timer' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="13" r="8" /><path d="M12 9v4l2.5 2.5M9 2h6M12 5V2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        )}
                        {tool.icon === 'book-open' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        )}
                        {tool.icon === 'clipboard' && (
                          <svg class="h-5.5 w-5.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12h6M9 16h6M7 3h10a2 2 0 0 1 2 2v16l-3-2-3 2-3-2-3 2V5a2 2 0 0 1 2-2Z" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        )}
                      </div>

                      <!-- Badge -->
                      <span class="rounded-full border border-hairline-strong bg-canvas-soft px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-tight text-body">
                        {tool.badge}
                      </span>
                    </div>

                    <!-- Info -->
                    <h4 class="mt-5 font-sans text-lg font-bold tracking-tight text-ink group-hover:text-link transition-colors">
                      {tool.title}
                    </h4>
                    <p class="mt-3 text-sm leading-relaxed text-body">
                      {tool.description}
                    </p>
                  </div>

                  <!-- CTA Link -->
                  <div class="mt-8 flex items-center text-xs font-bold uppercase tracking-widest text-link group-hover:text-link-deep transition-colors duration-150">
                    Launch Utility
                    <svg class="ml-2 h-4 w-4 transform transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14m-7-7 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <!-- Absolute link wrapper for overlay click -->
                    <a href={tool.href} class="absolute inset-0 z-10" aria-label={`Launch ${tool.title}`}></a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section (Self-contained schema generation) -->
  <section class="py-16 bg-canvas border-t border-hairline transition-colors duration-200">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center font-sans text-2xl font-semibold tracking-tight text-ink md:text-3xl">
        Frequently Asked Questions
      </h2>
      <p class="text-center mt-2 text-sm text-body">
        General queries about Student Utility Hub features and policies.
      </p>

      <div class="mt-10 divide-y divide-hairline border-t border-b border-hairline">
        {faq.map((item) => (
          <div class="py-4">
            <details class="group [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-base font-medium text-ink focus:outline-none select-none">
                <span>{item.question}</span>
                <span class="relative h-5 w-5 shrink-0">
                  <svg
                    class="absolute inset-0 h-5 w-5 opacity-100 group-open:opacity-0 transition-opacity duration-200"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 5v14m-7-7h14" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <svg
                    class="absolute inset-0 h-5 w-5 opacity-0 group-open:opacity-100 transition-opacity duration-200"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M5 12h14" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-body animate-fade-in">
                {item.answer}
              </p>
            </details>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Simple client-side search logic
  const searchInput = document.getElementById('tool-search') as HTMLInputElement | null;
  const toolCards = document.querySelectorAll('.tool-card');
  const categorySections = document.querySelectorAll('[data-category]');
  const noResultsDiv = document.getElementById('no-results');
  const toolsGrid = document.getElementById('tools-grid');
  const resultsCountSpan = document.getElementById('results-count');
  const resetBtn = document.getElementById('reset-search');

  if (searchInput && toolCards.length > 0 && noResultsDiv && toolsGrid) {
    const filterTools = () => {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      toolCards.forEach(card => {
        const htmlCard = card as HTMLElement;
        const title = htmlCard.dataset.title || '';
        const tags = htmlCard.dataset.tags || '';
        const desc = htmlCard.dataset.desc || '';

        const matches = title.includes(query) || tags.includes(query) || desc.includes(query);

        if (matches) {
          htmlCard.style.display = 'flex';
          visibleCount++;
        } else {
          htmlCard.style.display = 'none';
        }
      });

      // Hide category sections that have no visible cards
      categorySections.forEach(section => {
        const htmlSection = section as HTMLElement;
        const cards = htmlSection.querySelectorAll('.tool-card');
        let anyVisible = false;
        cards.forEach(card => {
          const htmlCard = card as HTMLElement;
          if (htmlCard.style.display !== 'none') {
            anyVisible = true;
          }
        });
        htmlSection.style.display = anyVisible ? '' : 'none';
      });

      // Show/Hide grids and empty state
      if (visibleCount === 0) {
        toolsGrid.classList.add('hidden');
        noResultsDiv.classList.remove('hidden');
      } else {
        toolsGrid.classList.remove('hidden');
        noResultsDiv.classList.add('hidden');
      }

      // Update count
      if (resultsCountSpan) {
        resultsCountSpan.textContent = `Showing ${visibleCount} utilities`;
      }
    };

    searchInput.addEventListener('input', filterTools);

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        searchInput.value = '';
        filterTools();
      });
    }
  }
</script>
