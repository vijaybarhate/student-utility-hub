---
import BaseLayout from '../layouts/BaseLayout.astro';

const faq = [
  {
    question: "Where are my saved exams stored?",
    answer: "Everything is saved locally in your browser's LocalStorage under the key suh-exams-v1. No data ever leaves your device — there is no account, no server, and no tracking."
  },
  {
    question: "How is the exam countdown calculated?",
    answer: "The countdown computes the number of whole days between today and the exam date (midnight to midnight, local time). Exams within 7 days are flagged with an amber urgency badge, and overdue exams are marked in red."
  },
  {
    question: "Does the countdown update automatically?",
    answer: "Yes. The list re-renders on every page load and refreshes itself every 60 seconds, so the countdown stays accurate even if you leave the tab open overnight."
  }
];
---

<BaseLayout
  title="Exam Countdown & Deadline Tracker"
  description="Track upcoming exams and deadlines with a live local-first countdown. Add your exam dates, see days remaining at a glance, and get urgency warnings before papers."
  {faq}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb & Header -->
    <nav class="flex mb-4" aria-label="Breadcrumb">
      <ol class="inline-flex items-center gap-1.5 font-mono text-[11px] text-mute">
        <li>
          <a href="/" class="hover:text-ink transition-colors">Home</a>
        </li>
        <li class="flex items-center gap-1.5 select-none">
          <span>/</span>
          <span class="text-body font-semibold">Exam Countdown</span>
        </li>
      </ol>
    </nav>

    <div class="mb-8">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="rounded-full border border-hairline bg-canvas px-3 py-1 font-mono text-[11px] font-semibold text-mute">
          Tool 06
        </span>
        <span class="font-mono text-[11px] uppercase tracking-wider text-mute">
          Know when it's due.
        </span>
      </div>
      <h1 class="mt-4 font-sans text-3xl font-semibold tracking-[-0.96px] text-ink sm:text-4xl">
        Exam Countdown &amp; Deadline Tracker
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-body">
        Add every paper, internal, and submission deadline once. See live countdowns, spot urgent exams within 7 days, and keep your whole term in view — all saved privately on your device.
      </p>
    </div>

    <!-- Main Tool Workspace -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Add Exam Form -->
      <div class="lg:col-span-5 min-w-0">
        <div class="rounded-md border border-hairline bg-canvas p-6 shadow-level-2 transition-colors duration-200 overflow-hidden">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-mute font-mono">
              Add Exam
            </h2>
            <span class="text-[10px] font-bold font-mono bg-canvas-soft-2 border border-hairline-strong rounded-full px-3 py-1 text-mute uppercase tracking-tight">
              Offline Cache
            </span>
          </div>

          <form id="exam-form" class="flex flex-col gap-6" novalidate>
            <div class="space-y-2">
              <label for="exam-name" class="block text-sm font-bold text-ink">
                Exam Name
              </label>
              <input
                type="text"
                id="exam-name"
                name="name"
                placeholder="e.g., Mathematics-II End Sem…"
                class="h-11 w-full rounded-md border border-hairline-strong bg-canvas px-4 text-sm text-ink placeholder-mute focus:ring-2 focus:ring-link/20 focus:outline-none transition-all"
                autocomplete="off"
                spellcheck="false"
                required
              />
            </div>

            <div class="space-y-2">
              <label for="exam-subject" class="block text-sm font-bold text-ink">
                Subject <span class="font-normal text-mute">(optional)</span>
              </label>
              <input
                type="text"
                id="exam-subject"
                name="subject"
                placeholder="e.g., Data Structures…"
                class="h-11 w-full rounded-md border border-hairline-strong bg-canvas px-4 text-sm text-ink placeholder-mute focus:ring-2 focus:ring-link/20 focus:outline-none transition-all"
                autocomplete="off"
                spellcheck="false"
              />
            </div>

            <div class="space-y-2">
              <label for="exam-date" class="block text-sm font-bold text-ink">
                Exam Date
              </label>
              <input
                type="date"
                id="exam-date"
                name="date"
                class="h-11 w-full rounded-md border border-hairline-strong bg-canvas px-4 text-sm text-ink focus:ring-2 focus:ring-link/20 focus:outline-none transition-all"
                required
              />
            </div>

            <p id="exam-form-error" class="hidden text-xs font-semibold text-error" role="alert">
              Please enter an exam name and a valid date.
            </p>

            <button type="submit" class="btn-primary !h-11 w-full">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 5v14m-7-7h14" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Add to Countdown
            </button>
          </form>
        </div>
      </div>

      <div id="exam-status-live" class="sr-only" role="status" aria-live="polite"></div>

      <!-- Saved Exams List -->
      <div class="lg:col-span-7 min-w-0">
        <div class="rounded-md border border-hairline bg-canvas p-6 shadow-level-2 transition-colors duration-200 overflow-hidden">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-mute font-mono">
              Saved Exams
            </h2>
            <span id="exam-count" class="font-mono text-[10px] font-bold bg-canvas-soft-2 border border-hairline-strong rounded-full px-3 py-1 text-mute uppercase tracking-tight">
              0 exams
            </span>
          </div>

          <!-- Next exam highlight -->
          <div id="next-exam" class="hidden mb-6 rounded-md border border-hairline-strong/20 bg-canvas-soft-2 p-5">
            <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-mute">Next Up</span>
            <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
              <div class="min-w-0">
                <h3 id="next-exam-name" class="truncate font-sans text-lg font-semibold tracking-tight text-ink"></h3>
                <p id="next-exam-date" class="mt-1 text-xs text-mute"></p>
              </div>
              <p id="next-exam-days" class="font-mono text-3xl font-bold tracking-tighter tabular-nums text-ink"></p>
            </div>
          </div>

          <div id="exam-list" class="divide-y divide-hairline">
            <!-- Dynamically populated -->
          </div>

          <!-- Empty state -->
          <div id="exam-empty-state" class="py-14 text-center border border-dashed border-hairline-strong rounded-md bg-canvas-soft">
            <svg class="mx-auto h-8 w-8 text-mute" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            <p class="mt-4 text-sm font-semibold text-body">No exams tracked yet.</p>
            <p class="mt-1 text-xs text-mute">Add your first exam on the left to start the countdown.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <section class="py-16 mt-16 border-t border-hairline transition-colors duration-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-center font-sans text-2xl font-semibold tracking-tight text-ink md:text-3xl">
          Exam Countdown FAQ
        </h2>
        <p class="text-center mt-2 text-sm text-body">
          How deadlines are counted and where your exam data lives.
        </p>

        <div class="mt-10 divide-y divide-hairline border-t border-b border-hairline bg-canvas px-6 rounded-md border">
          {faq.map((item) => (
            <div class="py-4">
              <details class="group [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-base font-medium text-ink focus:outline-none select-none">
                  <span>{item.question}</span>
                  <span class="relative h-5 w-5 shrink-0">
                    <svg
                      class="absolute inset-0 h-5 w-5 opacity-100 group-open:opacity-0 transition-opacity duration-200"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 5v14m-7-7h14" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <svg
                      class="absolute inset-0 h-5 w-5 opacity-0 group-open:opacity-100 transition-opacity duration-200"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M5 12h14" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-body animate-fade-in">
                  {item.answer}
                </p>
              </details>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { storageLoad, storageSave } from '../lib/storage';
  import { formatDays } from '../lib/format';

  const STORAGE_KEY = 'suh-exams-v1';

  interface Exam {
    id: string;
    name: string;
    date: string; // YYYY-MM-DD
    subject?: string;
  }

  const form = document.getElementById('exam-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('exam-name') as HTMLInputElement | null;
  const subjectInput = document.getElementById('exam-subject') as HTMLInputElement | null;
  const dateInput = document.getElementById('exam-date') as HTMLInputElement | null;
  const formError = document.getElementById('exam-form-error');

  const listEl = document.getElementById('exam-list');
  const emptyEl = document.getElementById('exam-empty-state');
  const countEl = document.getElementById('exam-count');
  const nextEl = document.getElementById('next-exam');
  const nextNameEl = document.getElementById('next-exam-name');
  const nextDateEl = document.getElementById('next-exam-date');
  const nextDaysEl = document.getElementById('next-exam-days');

  const statusLive = document.getElementById('exam-status-live');

  let exams: Exam[] = storageLoad<Exam[]>(STORAGE_KEY, []);

  const MS_PER_DAY = 86400000;

  function daysUntil(dateStr: string): number {
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const exam = new Date(`${dateStr}T00:00:00`);
    if (isNaN(exam.getTime())) return NaN;
    return Math.round((exam.getTime() - today.getTime()) / MS_PER_DAY);
  }

  function absoluteLabel(dateStr: string): string {
    const exam = new Date(`${dateStr}T00:00:00`);
    if (isNaN(exam.getTime())) return dateStr;
    return exam.toLocaleDateString(undefined, {
      weekday: 'short',
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
    ));
  }

  function announce(message: string) {
    if (statusLive) statusLive.textContent = message;
  }

  function render() {
    if (!listEl || !emptyEl || !countEl) return;

    exams.sort((a, b) => a.date.localeCompare(b.date));

    if (exams.length === 0) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      if (nextEl) nextEl.classList.add('hidden');
      countEl.textContent = '0 exams';
      announce('No exams tracked yet.');
      return;
    }

    emptyEl.classList.add('hidden');
    countEl.textContent = `${exams.length} exam${exams.length === 1 ? '' : 's'}`;

    listEl.innerHTML = exams.map((exam) => {
      const diff = daysUntil(exam.date);
      const safeDiff = isNaN(diff) ? 0 : diff;
      const subject = exam.subject ? `<span class="font-mono text-[10px] font-bold uppercase tracking-tight text-mute bg-canvas-soft-2 border border-hairline rounded-full px-2 py-0.5 mt-1.5 inline-block">${escapeHtml(exam.subject)}</span>` : '';

      let chipText: string;
      let badge: string;
      if (safeDiff < 0) {
        const overdue = Math.abs(safeDiff);
        chipText = `overdue ${overdue} day${overdue === 1 ? '' : 's'}`;
        badge = '<span class="rounded-full border border-error/30 bg-error/10 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-tight text-error">Overdue</span>';
      } else if (safeDiff === 0) {
        chipText = 'today';
        badge = '<span class="rounded-full border border-error/30 bg-error/10 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-tight text-error">Due today</span>';
      } else if (safeDiff <= 7) {
        chipText = formatDays(safeDiff);
        badge = '<span class="rounded-full border border-warning/40 bg-warning/10 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-tight text-warning-deep dark:text-warning">Due soon</span>';
      } else {
        chipText = formatDays(safeDiff);
        badge = '<span class="rounded-full border border-success/30 bg-success/10 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-tight text-success">Upcoming</span>';
      }

      return `
        <div class="py-4 flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3 class="font-sans text-sm font-semibold tracking-tight text-ink truncate">${escapeHtml(exam.name)}</h3>
            <p class="mt-1 font-mono text-[11px] text-mute">${absoluteLabel(exam.date)}</p>
            ${subject}
            <div class="mt-2">${badge}</div>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <span class="font-mono text-sm font-bold tabular-nums ${safeDiff < 0 ? 'text-error' : safeDiff === 0 ? 'text-error' : safeDiff <= 7 ? 'text-warning-deep dark:text-warning' : 'text-ink'}">${chipText}</span>
            <button
              type="button"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-hairline-strong text-mute transition-all hover:border-error hover:text-error hover:bg-error/5 focus:ring-2 focus:ring-error/20 focus:outline-none cursor-pointer"
              data-action="delete"
              data-id="${exam.id}"
              aria-label="Delete exam ${escapeHtml(exam.name)}"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
      `;
    }).join('');

    // Highlight the closest upcoming exam
    if (nextEl && nextNameEl && nextDateEl && nextDaysEl) {
      const upcoming = exams.filter((e) => !isNaN(daysUntil(e.date)) && daysUntil(e.date) >= 0).sort((a, b) => a.date.localeCompare(b.date))[0];
      if (upcoming) {
        nextNameEl.textContent = upcoming.name;
        nextDateEl.textContent = absoluteLabel(upcoming.date);
        const d = daysUntil(upcoming.date);
        nextDaysEl.textContent = d === 0 ? 'today' : formatDays(d);
        nextEl.classList.remove('hidden');
      } else {
        nextEl.classList.add('hidden');
      }
    }

    announce(`${exams.length} exams tracked.`);
  }

  function save() {
    storageSave(STORAGE_KEY, exams);
  }

  function addExam(event: Event) {
    event.preventDefault();
    if (!nameInput || !dateInput) return;

    const name = nameInput.value.trim();
    const date = dateInput.value;
    if (!name || !date) {
      if (formError) formError.classList.remove('hidden');
      return;
    }
    if (formError) formError.classList.add('hidden');

    const subject = subjectInput ? subjectInput.value.trim() : '';
    exams.push({
      id: typeof crypto !== 'undefined' && 'randomUUID' in crypto ? crypto.randomUUID() : String(Date.now()),
      name,
      date,
      subject: subject || undefined
    });
    save();
    render();

    form?.reset();
    nameInput.focus();
  }

  function deleteExam(id: string) {
    exams = exams.filter((e) => e.id !== id);
    save();
    render();
  }

  if (form) {
    form.addEventListener('submit', addExam);
  }

  if (listEl) {
    listEl.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest('button[data-action="delete"]') as HTMLElement | null;
      if (target && target.dataset.id) {
        deleteExam(target.dataset.id);
      }
    });
  }

  // Set the earliest selectable date to today (local time)
  if (dateInput) {
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth() + 1).padStart(2, '0');
    const d = String(now.getDate()).padStart(2, '0');
    dateInput.min = `${y}-${m}-${d}`;
  }

  render();
  window.setInterval(render, 60000);
</script>
