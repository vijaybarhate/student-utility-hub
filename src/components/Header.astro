---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/attendance-calculator', label: 'Attendance Calc' },
  { href: '/gpa-calculator', label: 'GPA Calc' },
  { href: '/cgpa-to-percentage', label: 'CGPA to %' },
  { href: '/marks-needed-to-pass', label: 'Pass Marks' },
  { href: '/atkt-eligibility-helper', label: 'ATKT Helper' },
  { href: '/exam-countdown', label: 'Exam Countdown' },
  { href: '/study-timer', label: 'Study Timer' },
  { href: '/semester-tracker', label: 'Semester Tracker' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md transition-colors duration-200">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
        <!-- Graduation cap logo -->
        <svg
          class="h-5 w-5 transition-transform duration-200 group-hover:scale-105"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <!-- mortarboard top -->
          <polygon points="12,3 22,8.5 12,14 2,8.5" />
          <!-- hanging body -->
          <rect x="8" y="12" width="8" height="6" rx="0.5" />
          <!-- tassel string -->
          <line x1="20" y1="8.5" x2="20" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <!-- tassel ball -->
          <circle cx="20" cy="15.8" r="1" />
        </svg>
        <span class="font-sans text-base font-bold tracking-[-0.8px] text-ink">
          Student Utility Hub
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="rounded-full px-3.5 py-1.5 text-[13px] font-bold text-mute hover:bg-canvas-soft-2 hover:text-ink transition-all duration-150 tracking-tight"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-3">
      <!-- Dark/Light Toggle -->
      <ThemeToggle />

      <a
        href="/contact"
        class="hidden sm:btn-primary !h-8 !px-4 !text-[11px] uppercase tracking-widest"
      >
        Feedback
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-hairline-strong text-ink hover:bg-canvas-soft-2 lg:hidden focus:ring-2 focus:ring-link/20 focus:outline-none"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Initially hidden) -->
  <div
    id="mobile-menu-drawer"
    class="hidden border-b border-hairline-strong bg-canvas px-4 py-6 transition-all duration-300 lg:hidden animate-fade-in shadow-xl"
  >
    <nav class="flex flex-col gap-3">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="block rounded-md px-4 py-3 text-sm font-bold text-body hover:bg-canvas-soft-2 hover:text-link transition-all border border-transparent hover:border-hairline"
        >
          {link.label}
        </a>
      ))}
      <div class="h-px bg-hairline-strong/20 my-4"></div>
      <a
        href="/contact"
        class="btn-primary w-full"
      >
        Send Feedback
      </a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle script
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menuDrawer = document.getElementById('mobile-menu-drawer');
  const menuIcon = document.getElementById('menu-icon');

  if (toggleBtn && menuDrawer && menuIcon) {
    let isOpen = false;

    toggleBtn.addEventListener('click', () => {
      isOpen = !isOpen;
      toggleBtn.setAttribute('aria-expanded', isOpen.toString());

      if (isOpen) {
        menuDrawer.classList.remove('hidden');
        // Change icon to close (X)
        menuIcon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      } else {
        menuDrawer.classList.add('hidden');
        // Change icon back to hamburger
        menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      }
    });

    // Close mobile drawer on resize to desktop size
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && isOpen) {
        isOpen = false;
        menuDrawer.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      }
    });
  }
</script>
